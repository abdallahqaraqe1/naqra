<?xml version="1.0" encoding="utf-8"?>
<!-- Naqra launcher foreground: glowing cyan action wheel arc, concentric click ripples, and cursor arrow. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer wheel arc around the right and bottom -->
    <path
        android:fillColor="#00000000"
        android:pathData="M53,27 A27,27 0 1,1 30.5,67.5"
        android:strokeWidth="5.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="53"
                android:startY="27"
                android:endX="31"
                android:endY="75"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF3CEBFF" />
                <item android:offset="0.55" android:color="#FF4DF7E6" />
                <item android:offset="1.0" android:color="#FF72FBD4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Concentric click ripples centered near the cursor tip (45, 39) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M39.8,44.2 A7.4,7.4 0 1,1 50.2,33.8"
        android:strokeColor="#E664FBF0"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#00000000"
        android:pathData="M36.5,47.5 A12.0,12.0 0 1,1 53.5,30.5"
        android:strokeColor="#B34EF2ED"
        android:strokeWidth="1.9"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#00000000"
        android:pathData="M33.2,50.8 A16.6,16.6 0 1,1 56.8,27.2"
        android:strokeColor="#663CEBFF"
        android:strokeWidth="1.4"
        android:strokeLineCap="round" />

    <!-- Cursor arrow body with cyan-tinted glass gradient -->
    <path
        android:pathData="M45.5,38.5 L50.2,65.2 L56.0,59.0 L63.2,69.5 C64.2,71.0 66.2,71.3 67.7,70.3 L69.8,68.8 C71.3,67.8 71.6,65.8 70.6,64.3 L63.4,53.8 L71.2,50.6 Z"
        android:strokeColor="#FF67F7F4"
        android:strokeWidth="1.4"
        android:strokeLineJoin="round">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="45.5"
                android:startY="38.5"
                android:endX="68.0"
                android:endY="69.5"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFE8FCFF" />
                <item android:offset="0.45" android:color="#FFA8DCFA" />
                <item android:offset="1.0" android:color="#FF6CA6E8" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
